# Rit B2B SaaS Portal — Nginx SPA server + /api reverse proxy

# Preserve HTTPS scheme when terminated at an upstream TLS reverse proxy.
map $http_x_forwarded_proto $proxy_proto {
    default $scheme;
    "~^(https?)$" $1;
}

# Prevent search engines from indexing internal portal subdomains or private login/panel routes.
map "$http_host$request_uri" $robots_tag {
    default "";
    ~*^(painel|portal|admin|gestao)\. "noindex, nofollow";
    ~*^[^/]+/(login|entrar|painel|setup-superadmin)(/|[?]|$) "noindex, nofollow";
}

server {
    listen ${NGINX_PORT};
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;
    absolute_redirect off;

    # Consolidate www.treinerit.com.br to the apex domain (without touching localhost/127.0.0.1 healthchecks).
    if ($http_host ~* ^www\.(treinerit\.com\.br)(:[0-9]+)?$) {
        return 301 $proxy_proto://$1$request_uri;
    }

    # Unwrap visitor IP only when forwarded through local/private reverse proxies (host nginx / Docker bridge).
    set_real_ip_from 127.0.0.1;
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; media-src 'self' blob:; frame-src https://www.youtube-nocookie.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none';" always;

    # Streamed video/image uploads up to 48 MiB for custom exercise demos
    location ^~ /api/gym/media/ {
        client_max_body_size 48m;
        proxy_request_buffering off;
        proxy_buffering off;
        resolver ${RESOLVER} valid=10s ipv6=off;
        set $api_upstream http://${BACKEND}:${PORT};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $proxy_proto;
        proxy_set_header CF-Connecting-IP "${CF_CONNECTING_IP}";
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
    }

    # Proxy /api/ to the Node backend container
    location ^~ /api/ {
        client_max_body_size 10m;
        resolver ${RESOLVER} valid=10s ipv6=off;
        set $api_upstream http://${BACKEND}:${PORT};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $proxy_proto;
        proxy_set_header CF-Connecting-IP "${CF_CONNECTING_IP}";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Exercise thumbnails & animations used by the Prescription Studio
    location ^~ /exercise-media/ {
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header Cache-Control "public, max-age=2592000, immutable";
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; media-src 'self' blob:; frame-src https://www.youtube-nocookie.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none';" always;
    }

    # Vite hashed assets -> immutable cache
    location ~* ^/assets/[^/]+-[A-Za-z0-9_-]+\.(js|css)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; media-src 'self' blob:; frame-src https://www.youtube-nocookie.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none';" always;
    }

    # PWA Service Worker & Manifest (sw.js nunca pode ficar em cache HTTP agressivo)
    location = /sw.js {
        try_files $uri =404;
        default_type application/javascript;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Robots-Tag $robots_tag always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none';" always;
    }

    location = /manifest.webmanifest {
        try_files $uri =404;
        default_type application/manifest+json;
        add_header Cache-Control "public, max-age=3600" always;
        add_header X-Robots-Tag $robots_tag always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none';" always;
    }

    # Serve robots.txt and sitemap.xml directly instead of falling back to the SPA shell
    location = /robots.txt {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=3600";
        add_header X-Robots-Tag $robots_tag always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none';" always;
    }

    location = /sitemap.xml {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=3600";
        add_header X-Robots-Tag $robots_tag always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none';" always;
    }

    # SPA fallback for Portal client-side views
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, must-revalidate";
        add_header X-Robots-Tag $robots_tag always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; media-src 'self' blob:; frame-src https://www.youtube-nocookie.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none';" always;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_vary on;
    gzip_min_length 1024;
}
