# ==============================================================================
# RIT - CONFIGURAÇÃO DE PRODUÇÃO (.env.production)
# ==============================================================================
# Instruções de implantação em produção:
# 1. Copie este arquivo para .env no servidor de produção: `cp .env.production.example .env`
# 2. Substitua os domínios pelo seu domínio real com HTTPS (ex: app.treinerit.com.br)
# 3. Gere senhas e chaves aleatórias para os campos marcados como [GERAR_CHAVE]
# 4. Inicie os containers compilando o código local: `docker compose up -d --build`
# ==============================================================================

# --- Domínio & Autenticação Biométrica / Passkey (WebAuthn) ---
# Em produção, WebAuthn e Passkeys exigem obrigatoriamente HTTPS e o domínio correto.
# RP_ID deve ser o domínio base da plataforma (sem https://, sem portas e sem barra no final).
# ORIGIN deve ser a URL completa com https:// usada pelos alunos no aplicativo Web/PWA.
RP_ID=treinerit.com.br
ORIGIN=https://app.treinerit.com.br
RP_NAME=Rit
DOMAIN_ROOT=treinerit.com.br
DOMAIN_APP=app.treinerit.com.br
DOMAIN_PORTAL=painel.treinerit.com.br
PORTAL_URL=https://painel.treinerit.com.br
VITE_STUDENT_APP_URL=https://app.treinerit.com.br
EVOLUTION_IMAGE_TAG=v2.3.7
EVOLUTION_WA_VERSION=2.3000.1054108093

# --- Portas Internas & Idioma ---
PORT=3000
WEB_PORT=8080
PORTAL_PORT=8081
DEFAULT_LANG=pt-BR
DATA_DIR=/data
TRUST_PROXY=1

# --- Segurança & Controle de Acesso (TRAVAS DE PRODUÇÃO) ---
# Em produção, desative estritamente o modo convidado e a promoção automática do primeiro usuário a admin.
PASSWORD_LOGIN=1
ALLOW_GUEST=0
FIRST_USER_ADMIN=0

# --- Modo Demonstração & Auto-Seed (OBRIGATÓRIO ZERO EM PRODUÇÃO) ---
# Com SAAS_AUTO_SEED=0, o servidor NÃO cria a senha padrão (rit2026) nem academias fictícias.
# Para criar o primeiro Super Administrador seguro da Rit, use o utilitário de linha de comando ou crie via banco.
SAAS_DEMO=0
SAAS_AUTO_SEED=0

# --- Integração Mercado Pago (PIX Oficial & Webhook) ---
# Obtenha seu Access Token de produção no painel do Mercado Pago:
# https://www.mercadopago.com.br/developers/panel/app
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-SEU-ACCESS-TOKEN-AQUI
# Opcional: Secret para validação da assinatura HMAC (header x-signature) do Webhook
MERCADO_PAGO_WEBHOOK_SECRET=

# --- Gateway Central WhatsApp (Evolution API v2) ---
# Em produção, a porta 8082 fica restrita a 127.0.0.1 (não exposta publicamente na internet).
# A comunicação entre o backend da Rit e a Evolution API ocorre pela rede interna do Docker.
EVOLUTION_BIND=127.0.0.1
EVOLUTION_PORT=8082
EVOLUTION_INSTANCE=rit
# Gere uma chave forte (ex: openssl rand -hex 24):
EVOLUTION_API_KEY=GERAR_CHAVE_FORTE_AQUI_EX_c3a9f0e1b2d45678a1b2c3d4e5f60718

# --- Banco PostgreSQL da Evolution API ---
EVOLUTION_DB_USER=evolution
# Gere uma senha forte para o banco de dados do WhatsApp (ex: openssl rand -hex 16):
EVOLUTION_DB_PASS=GERAR_SENHA_FORTE_POSTGRES_EX_9f8e7d6c5b4a3210
EVOLUTION_DB_NAME=evolution

# --- Otimização de Rede & Proxy Reverso (Nginx / Cloudflare) ---
# Se você usa Cloudflare na frente da sua aplicação, descomente:
# CF_CONNECTING_IP='$http_cf_connecting_ip'
